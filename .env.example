# === Google Sheets / Drive ===
# Full Google Sheet URL (preferred) - copy from browser address bar
# Example: https://docs.google.com/spreadsheets/d/1AbC123.../edit#gid=0
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit
# Alternative: plain Spreadsheet ID (backward compat). GOOGLE_SHEET_URL takes precedence.
# SPREADSHEET_ID=YOUR_SPREADSHEET_ID
SHEET_NAME=Sheet1

# Drive output folder ID (where MP3s will be uploaded)
# From URL: https://drive.google.com/drive/folders/<THIS_ID>
# Leave empty to upload to My Drive root (service account's drive)
DRIVE_OUTPUT_FOLDER_ID=
# Backward compat alias:
# DRIVE_FOLDER_ID=

# Path to Google credentials JSON (service account key)
# Download from GCP Console -> IAM & Admin -> Service Accounts -> Keys -> Create JSON
GOOGLE_CREDENTIALS_FILE=credentials/service_account.json
# Backward compat alias:
# GOOGLE_CREDENTIALS_PATH=credentials/service_account.json

# For OAuth flow token storage (only if using OAuth client instead of service account)
GOOGLE_TOKEN_PATH=credentials/token.json

# === LLM — ALL OPTIONAL ===
# Basic workflow and sheet connection test need NO LLM and NO API key.
# Default is free rule-based Python fallback (no deps).
# Ollama is optional for higher quality later. OPENAI_API_KEY is optional-only.
LLM_PROVIDER=
# Leave empty for rule-based default. Set to enable: openai | gemini | groq | ollama
# LLM_MODEL only needed when LLM_PROVIDER is set.
# Examples: openai: gpt-4o-mini / gpt-4o
#           gemini: gemini-1.5-flash / gemini-1.5-pro
#           groq: llama-3.1-70b-versatile
#           ollama: llama3.1:8b (requires Ollama installed)
LLM_MODEL=

# All keys optional — sheet test must run without any of them
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434  # only if LLM_PROVIDER=ollama

# === Behavior ===
POLL_INTERVAL_SECONDS=60
MAX_TRANSCRIPT_CHARS=12000
MAX_PODCAST_TURNS=14

# === Telugu TTS — open-source-first ===
# Default per policy is fully open-source offline: piper | ai4bharat | coqui
# edge/gtts are secondary/optional (free but proprietary endpoints, not open-source)
TTS_ENGINE=piper
PIPER_BINARY_PATH=
PIPER_MODEL_PATH_TE_FEMALE=
PIPER_MODEL_PATH_TE_MALE=

# === Output ===
OUTPUT_DIR=output
