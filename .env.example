# === Google Sheets / Drive ===
# Full Google Sheet URL (preferred) - copy from browser address bar
# Example: https://docs.google.com/spreadsheets/d/1AbC123.../edit#gid=0
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit
# Alternative: plain Spreadsheet ID (backward compat). GOOGLE_SHEET_URL takes precedence.
# SPREADSHEET_ID=YOUR_SPREADSHEET_ID
SHEET_NAME=Sheet1

# Drive output folder ID (where MP3s will be uploaded)
# From URL: https://drive.google.com/drive/folders/<THIS_ID>
# Leave empty to upload to My Drive root (service account's drive)
DRIVE_OUTPUT_FOLDER_ID=
# Backward compat alias:
# DRIVE_FOLDER_ID=

# Path to Google credentials JSON (service account key)
# Download from GCP Console -> IAM & Admin -> Service Accounts -> Keys -> Create JSON
GOOGLE_CREDENTIALS_FILE=credentials/service_account.json
# Backward compat alias:
# GOOGLE_CREDENTIALS_PATH=credentials/service_account.json

# For OAuth flow token storage (only if using OAuth client instead of service account)
GOOGLE_TOKEN_PATH=credentials/token.json

# === LLM — Phase 2 Milestone 3: Gemini 3.5 Flash primary (Ollama optional fallback) ===
# Default provider: gemini (requires GEMINI_API_KEY) — src/llm.py provider-agnostic
# Primary model: gemini-3.5-flash — keep Ollama as optional: LLM_PROVIDER=ollama, LLM_MODEL=gemma2:9b
# Rule-based fallback is used automatically when GEMINI_API_KEY missing or Ollama not running,
# so sheet/transcript still work with no LLM. Set LLM_PROVIDER empty or rule-based/none to force fallback.
LLM_PROVIDER=gemini
# Options: gemini (primary) | ollama (optional local) | openai | groq | (empty/rule-based/none for pure fallback)
LLM_MODEL=gemini-3.5-flash
# Examples: gemini: gemini-3.5-flash (primary default) / gemini-1.5-flash / gemini-1.5-pro
#           ollama: gemma2:9b / gemma2:2b / llama3.1:8b  (requires OLLAMA_BASE_URL)
#           openai: gpt-4o-mini / gpt-4o
#           groq: llama-3.1-70b-versatile
# OLLAMA_BASE_URL from env (src/llm.py uses config.OLLAMA_BASE_URL) — only needed if LLM_PROVIDER=ollama

# GEMINI_API_KEY is primary — set in .env (never hardcoded); other keys optional — sheet test works without any
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434  # Ollama server; only used when LLM_PROVIDER=ollama

# === Behavior ===
POLL_INTERVAL_SECONDS=60
MAX_TRANSCRIPT_CHARS=12000
MAX_PODCAST_TURNS=14

# === Telugu TTS — open-source-first ===
# Default per policy is fully open-source offline: piper | ai4bharat | coqui
# edge/gtts are secondary/optional (free but proprietary endpoints, not open-source)
TTS_ENGINE=piper
PIPER_BINARY_PATH=
PIPER_MODEL_PATH_TE_FEMALE=
PIPER_MODEL_PATH_TE_MALE=

# === Output ===
OUTPUT_DIR=output
